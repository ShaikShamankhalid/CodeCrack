Code for the every time pivot element get settled :

#include <stdio.h>

void quicksort(int a[], int low, int high)
{
    if (low >= high)
        return;

    int pivot = a[low], i = low + 1, j = high, temp, k;

    printf("\nPivot %d selected at position %d", pivot, low + 1);

    while (i <= j)
    {
        while (i <= high && a[i] <= pivot)
            i++;

        while (a[j] > pivot)
            j--;

        if (i < j)
        {
            temp = a[i];
            a[i] = a[j];
            a[j] = temp;

            printf("\nSwapped %d and %d: ", a[j], a[i]);
            for (k = low; k <= high; k++)
                printf("%d ", a[k]);
        }
    }

    a[low] = a[j];
    a[j] = pivot;

    printf("\nPivot %d moved to position %d", pivot, j + 1);

    printf("\nLeft subarray: ");
    for (k = low; k < j; k++)
        printf("%d ", a[k]);

    printf("\nRight subarray: ");
    for (k = j + 1; k <= high; k++)
        printf("%d ", a[k]);

    printf("\n");

    quicksort(a, low, j - 1);
    quicksort(a, j + 1, high);
}

int main()
{
    int a[100], n, i;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    quicksort(a, 0, n - 1);

    printf("\nSorted elements:\n");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    return 0;
}

