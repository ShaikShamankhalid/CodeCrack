# 5. Simple C Program — Red-Black Tree Insertion

This version performs **insertion only**, uses rotations and recoloring, and keeps the implementation relatively short.

```c
#include <stdio.h>
#include <stdlib.h>

#define RED 1
#define BLACK 0

typedef struct Node {
    int data, color;
    struct Node *left, *right, *parent;
} Node;

Node *root = NULL;

Node* newNode(int x) {
    Node *n = malloc(sizeof(Node));
    n->data = x;
    n->color = RED;
    n->left = n->right = n->parent = NULL;
    return n;
}

void leftRotate(Node *x) {
    Node *y = x->right;
    x->right = y->left;

    if (y->left) y->left->parent = x;
    y->parent = x->parent;

    if (!x->parent) root = y;
    else if (x == x->parent->left) x->parent->left = y;
    else x->parent->right = y;

    y->left = x;
    x->parent = y;
}

void rightRotate(Node *x) {
    Node *y = x->left;
    x->left = y->right;

    if (y->right) y->right->parent = x;
    y->parent = x->parent;

    if (!x->parent) root = y;
    else if (x == x->parent->left) x->parent->left = y;
    else x->parent->right = y;

    y->right = x;
    x->parent = y;
}

void fixInsert(Node *z) {
    while (z != root && z->parent->color == RED) {
        Node *p = z->parent;
        Node *g = p->parent;

        if (p == g->left) {
            Node *u = g->right;

            if (u && u->color == RED) {
                p->color = BLACK;
                u->color = BLACK;
                g->color = RED;
                z = g;
            } else {
                if (z == p->right) {
                    z = p;
                    leftRotate(z);
                    p = z->parent;
                    g = p->parent;
                }
                p->color = BLACK;
                g->color = RED;
                rightRotate(g);
            }
        } else {
            Node *u = g->left;

            if (u && u->color == RED) {
                p->color = BLACK;
                u->color = BLACK;
                g->color = RED;
                z = g;
            } else {
                if (z == p->left) {
                    z = p;
                    rightRotate(z);
                    p = z->parent;
                    g = p->parent;
                }
                p->color = BLACK;
                g->color = RED;
                leftRotate(g);
            }
        }
    }

    root->color = BLACK;
}

void insert(int x) {
    Node *z = newNode(x);
    Node *p = NULL, *q = root;

    while (q) {
        p = q;
        q = (x < q->data) ? q->left : q->right;
    }

    z->parent = p;

    if (!p) root = z;
    else if (x < p->data) p->left = z;
    else p->right = z;

    fixInsert(z);
}

void inorder(Node *r) {
    if (!r) return;
    inorder(r->left);
    printf("%d(%s) ", r->data, r->color ? "R" : "B");
    inorder(r->right);
}

int main() {
    int n, x;

    printf("Enter number of nodes: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    while (n--) {
        scanf("%d", &x);
        insert(x);
    }

    printf("Inorder: ");
    inorder(root);

    return 0;
}
```

