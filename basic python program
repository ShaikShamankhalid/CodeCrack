# 1. Creating Lists
arr = [10, 20, 30, 40, 50]
empty = []
mixed = [10, "Python", 20.5, True]

print("Array:", arr)
print("Empty List:", empty)
print("Mixed List:", mixed)

# 2. Accessing Elements (Indexing)
print("First:", arr[0])
print("Last:", arr[-1])
print("Second:", arr[1])

# 3. Slicing
print("First 3:", arr[0:3])
print("From index 2:", arr[2:])
print("Before index 3:", arr[:3])
print("Copy:", arr[:])
print("Every 2nd:", arr[::2])
print("Reverse:", arr[::-1])
print("Reverse using step:", arr[::-2])

# Syntax: arr[start : stop : step]

# 4. Updating Elements
arr[0] = 100
arr[-1] = 500
print("Updated:", arr)

# 5. Adding Elements
arr.append(60)           # Add at end
arr.insert(1, 15)        # Add at index 1
arr.extend([70, 80, 90]) # Add multiple elements
print("After Adding:", arr)

# 6. Removing Elements
arr.remove(30)           # Remove value 30
arr.pop()                # Remove last element
arr.pop(0)               # Remove element at index 0
del arr[1]               # Delete using index
print("After Removing:", arr)

# 7. Searching Elements
nums = [10, 20, 30, 20, 40]

print("Index:", nums.index(20))
print("Count:", nums.count(20))
print("Contains:", 30 in nums)
print("Not Contains:", 100 not in nums)

# 8. Sorting
values = [50, 10, 40, 20, 30]

values.sort()             # Ascending
print("Ascending:", values)

values.sort(reverse=True) # Descending
print("Descending:", values)

# sorted() returns a new sorted list
new_arr = sorted(values)
print("Sorted Copy:", new_arr)

# 9. Reversing
values.reverse()
print("Reversed:", values)

