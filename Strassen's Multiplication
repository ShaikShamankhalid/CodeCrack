Implement the following using divide and conquer approach.
To multiply two given square matrices using Strassen’s matrix multiplication

CODE : 

#include <stdio.h>
#define N 2

void add(int n, int a[n][n], int b[n][n], int c[n][n], int s) {
    for (int i=0; i<n; i++)
        for (int j=0; j<n; j++)
            c[i][j] = a[i][j] + s*b[i][j];
}

void strassen(int n, int a[n][n], int b[n][n], int c[n][n]) {
    if (n == 1) {
        c[0][0] = a[0][0] * b[0][0];
        return;
    }

    int k = n/2;
    int a11[k][k], a12[k][k], a21[k][k], a22[k][k];
    int b11[k][k], b12[k][k], b21[k][k], b22[k][k];
    int m1[k][k], m2[k][k], m3[k][k], m4[k][k];
    int m5[k][k], m6[k][k], m7[k][k];
    int x[k][k], y[k][k], t[k][k];

    // Divide matrices into four parts
    for (int i=0; i<k; i++)
        for (int j=0; j<k; j++) {
            a11[i][j]=a[i][j];     b11[i][j]=b[i][j];
            a12[i][j]=a[i][j+k];   b12[i][j]=b[i][j+k];
            a21[i][j]=a[i+k][j];   b21[i][j]=b[i+k][j];
            a22[i][j]=a[i+k][j+k]; b22[i][j]=b[i+k][j+k];
        }

    // Calculate seven products recursively
    add(k,a11,a22,x,1); add(k,b11,b22,y,1);
    strassen(k,x,y,m1);

    add(k,a21,a22,x,1); strassen(k,x,b11,m2);

    add(k,b12,b22,y,-1); strassen(k,a11,y,m3);

    add(k,b21,b11,y,-1); strassen(k,a22,y,m4);

    add(k,a11,a12,x,1); strassen(k,x,b22,m5);

    add(k,a21,a11,x,-1); add(k,b11,b12,y,1);
    strassen(k,x,y,m6);

    add(k,a12,a22,x,-1); add(k,b21,b22,y,1);
    strassen(k,x,y,m7);

    // Combine seven products into result matrix
    for (int i=0; i<k; i++)
        for (int j=0; j<k; j++) {
            c[i][j]     = m1[i][j]+m4[i][j]-m5[i][j]+m7[i][j];
            c[i][j+k]   = m3[i][j]+m5[i][j];
            c[i+k][j]   = m2[i][j]+m4[i][j];
            c[i+k][j+k] = m1[i][j]-m2[i][j]+m3[i][j]+m6[i][j];
        }
}

int main() {
    int a[N][N], b[N][N], c[N][N];

    printf("Enter first matrix:\n");
    for(int i=0;i<N;i++)
        for(int j=0;j<N;j++) scanf("%d",&a[i][j]);

    printf("Enter second matrix:\n");
    for(int i=0;i<N;i++)
        for(int j=0;j<N;j++) scanf("%d",&b[i][j]);

    strassen(N,a,b,c);

    printf("Result matrix:\n");
    for(int i=0;i<N;i++) {
        for(int j=0;j<N;j++) printf("%d ",c[i][j]);
        printf("\n");
    }
    return 0;
}

Code for 2*2 matrix :


#include<stdio.h>
int main()
{
    int a[2][2],b[2][2],c[2][2];
    int p1,p2,p3,p4,p5,p6,p7;
    int i,j;

    printf("Enter first matrix:");
    for(i=0;i<2;i++)
        for(j=0;j<2;j++)
            scanf("%d",&a[i][j]);

    printf("Enter second matrix:");
    for(i=0;i<2;i++)
        for(j=0;j<2;j++)
            scanf("%d",&b[i][j]);

    // Strassen seven multiplications

    p1=(a[0][0]+a[1][1])*(b[0][0]+b[1][1]);

    p2=(a[1][0]+a[1][1])*b[0][0];

    p3=a[0][0]*(b[0][1]-b[1][1]);

    p4=a[1][1]*(b[1][0]-b[0][0]);

    p5=(a[0][0]+a[0][1])*b[1][1];

    p6=(a[1][0]-a[0][0])*(b[0][0]+b[0][1]);

    p7=(a[0][1]-a[1][1])*(b[1][0]+b[1][1]);

    // Calculate result matrix

    c[0][0]=p1+p4-p5+p7;
    c[0][1]=p3+p5;
    c[1][0]=p2+p4;
    c[1][1]=p1-p2+p3+p6;

    printf("Result matrix:\n");

    for(i=0;i<2;i++)
    {
        for(j=0;j<2;j++)
            printf("%d ",c[i][j]);

        printf("\n");
    }

    return 0;
}

1. First remember the matrix
\[
A=\begin{bmatrix}a&b\\c&d\end{bmatrix}
\quad
B=\begin{bmatrix}e&f\\g&h\end{bmatrix}
\]

2. Seven formulas – easy memory trick
Formula	Easy way to remember
P1	(a+d) × (e+h)
P2	(c+d) × e
P3	a × (f-h)
P4	d × (g-e)
P5	(a+b) × h
P6	(c-a) × (e+f)
P7	(b-d) × (g+h)

Memorize these patterns:
- P1: Both diagonals added.
- P2: Last row of A + first element of B.
- P3: First element of A × (f-h).
- P4: Last element of A × (g-e).
- P5: First row of A × last element of B.
- P6: (c-a) × (e+f).
- P7: (b-d) × (g+h).

3. Final answer formulas

Position	Formula
C11	1 + 4 - 5 + 7
C12	3 + 5
C21	2 + 4
C22	1 - 2 + 3 + 6
