Design the Algorithm to solve fractional Knapsack problem using Greedy method.
Analyze the time complexity and implement the above algorithm.

CODE :

#include <stdio.h>

int main() {
    int n, i, j;
    float w[20], p[20], r[20], temp;
    float cap, profit = 0;

    printf("Enter number of items: ");
    scanf("%d", &n);

    printf("Enter capacity: ");
    scanf("%f", &cap);

    for (i = 0; i < n; i++) {
        printf("Enter weight and profit: ");
        scanf("%f%f", &w[i], &p[i]);
        r[i] = p[i] / w[i];
    }

    // Sort according to profit/weight ratio
    for (i = 0; i < n - 1; i++)
        for (j = i + 1; j < n; j++)
            if (r[i] < r[j]) {
                temp = r[i]; r[i] = r[j]; r[j] = temp;
                temp = w[i]; w[i] = w[j]; w[j] = temp;
                temp = p[i]; p[i] = p[j]; p[j] = temp;
            }

    // Select items
    for (i = 0; i < n; i++) {
        if (w[i] <= cap) {
            profit += p[i];
            cap -= w[i];
        }
        else {
            profit += r[i] * cap;
            break;
        }
    }

    printf("Maximum profit = %.2f", profit);

    return 0;
}

